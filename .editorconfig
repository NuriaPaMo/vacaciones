root = true

# ─── All files ────────────────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# ─── C# — constitution XIV ────────────────────────────────────────────────────
[*.cs]
indent_size = 4
max_line_length = 120

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Naming: PascalCase for all public/protected types and members
dotnet_naming_rule.public_members_pascal.symbols                 = public_symbols
dotnet_naming_rule.public_members_pascal.style                   = pascal_case_style
dotnet_naming_rule.public_members_pascal.severity                = warning

dotnet_naming_symbols.public_symbols.applicable_kinds            = class,struct,enum,interface,delegate,method,property,event,field
dotnet_naming_symbols.public_symbols.applicable_accessibilities  = public,protected,protected_internal

dotnet_naming_style.pascal_case_style.capitalization             = pascal_case

# Naming: _camelCase for private fields (constitution XIV)
dotnet_naming_rule.private_fields_camel.symbols                  = private_fields
dotnet_naming_rule.private_fields_camel.style                    = underscore_camel_style
dotnet_naming_rule.private_fields_camel.severity                 = warning

dotnet_naming_symbols.private_fields.applicable_kinds            = field
dotnet_naming_symbols.private_fields.applicable_accessibilities  = private,private_protected

dotnet_naming_style.underscore_camel_style.capitalization        = camel_case
dotnet_naming_style.underscore_camel_style.required_prefix       = _

# Interfaces must start with I (constitution XIV)
dotnet_naming_rule.interfaces_prefix_i.symbols                   = interface_types
dotnet_naming_rule.interfaces_prefix_i.style                     = interface_style
dotnet_naming_rule.interfaces_prefix_i.severity                  = warning

dotnet_naming_symbols.interface_types.applicable_kinds           = interface
dotnet_naming_style.interface_style.required_prefix              = I
dotnet_naming_style.interface_style.capitalization               = pascal_case

# Nullable reference types enabled (constitution XIV)
dotnet_diagnostic.CS8600.severity  = error
dotnet_diagnostic.CS8601.severity  = error
dotnet_diagnostic.CS8602.severity  = error
dotnet_diagnostic.CS8603.severity  = error
dotnet_diagnostic.CS8604.severity  = error

# Remove unused usings
dotnet_diagnostic.IDE0005.severity = warning

# ─── TypeScript / Vue / JS — constitution XIV ─────────────────────────────────
[*.{ts,tsx,vue,js,jsx}]
indent_size = 2
max_line_length = 100

# ─── JSON ─────────────────────────────────────────────────────────────────────
[*.json]
indent_size = 2

# ─── YAML ─────────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ─── Terraform ────────────────────────────────────────────────────────────────
[*.tf]
indent_size = 2

# ─── Markdown ─────────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
