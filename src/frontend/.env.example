# Frontend environment variables — copy to .env.local for local development
# NEVER commit .env.local to source control

# API base URL (Aspire-discovered in local dev; Container App URL in deployed envs)
VITE_API_BASE_URL=http://localhost:5000

# Entra ID / MSAL configuration
VITE_MSAL_CLIENT_ID=<your-spa-client-id>
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
VITE_MSAL_REDIRECT_URI=http://localhost:5173
VITE_MSAL_SCOPES=api://<api-client-id>/access_as_user

# Application Insights (optional — OTel RUM for local dev)
VITE_APP_INSIGHTS_CONNECTION_STRING=
